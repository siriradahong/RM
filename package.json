{
  "name": "kkmuni-report-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test": "node --test tests/api.test.js tests/demo.test.mjs tests/client-api.test.mjs tests/workflows.test.mjs tests/drafts.test.mjs tests/extraction.test.mjs tests/insights.test.mjs tests/scope.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "demo:seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "test:workflows": "node tests/workflows-browser.mjs",
    "test:drafts": "node tests/drafts-browser.mjs",
    "ocr:setup": "node --env-file-if-exists=.env scripts/setup-ocr.mjs",
    "test:usability": "node tests/usability-browser.mjs",
    "test:scope": "node tests/scope-browser.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@napi-rs/canvas": "^1.0.11",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.49.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
