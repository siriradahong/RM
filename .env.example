NODE_ENV=development
PORT=3001
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173,http://localhost:3001
DATA_DIR=./data
# Set to 1 only when behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Production requires HTTPS; cookies are Secure when NODE_ENV=production.
# LINE values stay server-side. Never use VITE_ for secrets.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_REPORT_GROUP_ID=
LINE_NEWS_GROUP_ID=

# Optional: local Thai/English OCR model directory (default data/ocr).
# Run npm run ocr:setup once before reading scanned documents.
# OCR_MODEL_DIR=./data/ocr

# LINE Login (same LINE provider as the Messaging API channel).
# Use the registered HTTPS origin in production. Callback: /api/auth/line/callback
PUBLIC_BASE_URL=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Optional local Ollama model. Leave unset to use local document reading only.
# No Gemini integration or model fine-tuning is used.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional antivirus. When enabled, an unavailable scanner rejects the upload.
ANTIVIRUS_ENABLED=0
CLAMSCAN_PATH=clamscan

# Public official-account chat/add-friend link (HTTPS line.me or lin.ee), shown on the LINE reporting page.
LINE_OA_URL=
