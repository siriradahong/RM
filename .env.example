NODE_ENV=development
PORT=3001
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173,http://localhost:3001
DATA_DIR=./data
# Set to 1 only when behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Production requires HTTPS; cookies are Secure when NODE_ENV=production.
# LINE values stay server-side. Never use VITE_ for secrets.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_REPORT_GROUP_ID=
LINE_NEWS_GROUP_ID=

# Optional local AI server; leave model blank to keep model calls disabled.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Absolute path to a Python environment with document-reader dependencies.
DOCUMENT_PYTHON=
# Public HTTPS URL of this RM app, used only for the LINE review link.
PUBLIC_APP_URL=
